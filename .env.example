SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# development | production (surfaced on /health)
APP_ENV=development
API_KEY=change-this-to-a-long-random-secret
PRICE_HISTORY_DIR=data_manager/data/historical_prices
# Days of history to fetch when stock_prices is empty (first run)
PRICE_INITIAL_LOOKBACK_DAYS=365
NEWS_COUNTRY=IN
NEWS_LANGUAGE=en
NEWS_MAX_RESULTS=15
# Example SMA crossover hook (optional)
PREDICTION_FUNCTION=prediction.predict:predict_stock
# Comma-separated: google_rss,custom
NEWS_PROVIDERS=google_rss,custom
MONEYCONTROL_NEWS_ENABLED=true
MONEYCONTROL_NEWS_MAX=10
LOG_LEVEL=INFO

# HTTP retry for yfinance / exchange APIs
HTTP_RETRY_ATTEMPTS=3
HTTP_RETRY_BASE_DELAY_SEC=1.0

# Failure alerts (optional). Set ALERT_ON_FAILURE=false to disable.
ALERT_ON_FAILURE=true
ALERT_SLACK_WEBHOOK_URL=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Supabase Storage CSV mirror (optional)
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_PREFIX=historical_prices
